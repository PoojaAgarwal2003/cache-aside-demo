meta {
  name: Cold read
  type: http
  seq: 3
}
get {
  url: {{baseUrl}}/products/{{productId}}
  body: none
  auth: none
}
script:post-response {
  bru.setVar("warmDeadline", Date.now() + 10000);
}
tests {
  test("real cold database read with flow", function () {
    expect(res.status).to.equal(200);
    expect(res.body.source).to.equal("DATABASE");
    expect(res.body.flow).to.be.an("array").that.is.not.empty;
    expect(res.body.cacheWriteOutcome).to.be.a("string");
  });
}
