meta {
  name: PUT compatibility
  type: http
  seq: 6
}
put {
  url: {{baseUrl}}/products/{{productId}}
  body: json
  auth: none
}
body:json {
  {"price":14.25}
}
tests {
  test("legacy PUT is also partial, with trigger versioning", function () {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Patched by Bruno");
    expect(res.body.stock).to.equal(10);
    expect(res.body.price).to.equal(14.25);
    expect(res.body.version).to.be.greaterThan(bru.getVar("patchedVersion"));
  });
}
