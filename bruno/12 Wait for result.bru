meta {
  name: Wait for result
  type: http
  seq: 12
}
get {
  url: {{baseUrl}}/demo/runs/{{runId}}
  body: none
  auth: none
}
script:post-response {
  if (res.body.active) {
    if (Date.now() >= bru.getVar("runDeadline")) throw new Error("Run did not finalize within 45 seconds.");
    await bru.sleep(250);
    bru.runner.setNextRequest("Wait for result");
  }
}
tests {
  test("snapshot stays correlated; terminal state must be a verified completion", function () {
    expect(res.status).to.equal(200);
    expect(res.body.runId).to.equal(bru.getVar("runId"));
    if (!res.body.active) {
      expect(res.body.state).to.equal("COMPLETED");
      expect(res.body.result.invariantVerdict).to.equal("PASS");
      expect(res.body.result.soldQuantity).to.equal(3);
    }
  });
}
